{
  "routes": [
    {
      "route": "/api/beheer-content",
      "allowedRoles": ["beheerder"]
    },
    {
      "route": "/api/beheer-instellingen",
      "allowedRoles": ["beheerder"]
    },
    {
      "route": "/api/beheer-klantcategorieen",
      "allowedRoles": ["beheerder"]
    },
    {
      "route": "/api/beheer-logo",
      "allowedRoles": ["beheerder"]
    },
    {
      "route": "/api/instellingen",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}
